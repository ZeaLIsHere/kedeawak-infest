# Contoh variabel lingkungan KedeAwak.
#
# Cara pakai: salin berkas ini menjadi `.env.local`, lalu isi nilainya.
# Berkas `.env.local` tidak pernah masuk git, lihat docs/ARCHITECTURE.md
# bagian 8. Berkas ini hanya memuat nama variabel dan contoh nilai yang aman,
# tanpa rahasia apa pun.

# Model bahasa DeepSeek. Kunci wajib diisi.
# Lihat docs/ARCHITECTURE.md bagian 5.1.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash

# Basis data. PGlite menyimpan berkasnya di dalam folder ini pada mode lokal.
PGLITE_DATA_DIR=.pglite/kedeawak

# Kunci enkripsi nama dan nomor telepon pelanggan. Isinya 32 bita dalam bentuk
# heksadesimal, jadi 64 karakter. Lihat docs/ARCHITECTURE.md bagian 8.
FIELD_ENCRYPTION_KEY=

# Penyedia kanal WhatsApp, yaitu Fonnte. Token perangkat diambil dari dasbor
# Fonnte. Dipakai untuk memeriksa status koneksi nomor pada permukaan S3.
# Lihat docs/ARCHITECTURE.md bagian 11.
FONNTE_TOKEN=
