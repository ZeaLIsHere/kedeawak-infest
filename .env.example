# Contoh variabel lingkungan KedeAwak.
#
# Cara pakai: salin berkas ini menjadi `.env.local`, lalu isi nilainya.
# Berkas `.env.local` tidak pernah masuk git, lihat docs/ARCHITECTURE.md
# bagian 8. Berkas ini hanya memuat nama variabel dan contoh nilai yang aman,
# tanpa rahasia apa pun.

# Model bahasa DeepSeek. Kunci wajib diisi.
# Urutan pilihan model: DEEPSEEK_CHAT_MODEL atau DEEPSEEK_VISION_MODEL,
# lalu DEEPSEEK_MODEL, lalu bawaan deepseek-flash.
# Lihat docs/ARCHITECTURE.md bagian 5.1.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_CHAT_MODEL=
DEEPSEEK_VISION_MODEL=

# Transkripsi voice note WhatsApp memakai Groq Whisper.
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Basis data. Biarkan kosong untuk memakai PGlite, yaitu PostgreSQL asli yang
# berjalan di dalam proses, tanpa pemasangan server. Isi dengan alamat
# PostgreSQL biasa untuk memakai server sungguhan. Lihat docs/ARCHITECTURE.md
# bagian 12.
DATABASE_URL=
PGLITE_DATA_DIR=.pglite/kedeawak

# Kunci enkripsi nama dan nomor telepon pelanggan. Isinya 32 bita dalam bentuk
# heksadesimal, jadi 64 karakter. Buat kuncinya sekali dengan perintah berikut,
# lalu simpan hasilnya. Ganti kunci berarti data lama tidak dapat dibuka lagi.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Lihat docs/ARCHITECTURE.md bagian 8.
FIELD_ENCRYPTION_KEY=

# Twilio WhatsApp Sandbox. Kredensial hanya dibaca di server dan tidak pernah
# disimpan di basis data atau browser. Nomor pengirim memakai awalan whatsapp:.
# Lihat docs/ARCHITECTURE.md bagian 11.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+

# URL HTTPS publik lengkap dari ngrok, termasuk path webhook. Nilai ini harus
# sama persis dengan When a message comes in pada Twilio Sandbox.
WEBHOOK_URL=https://DOMAIN_NGROK/api/channels/whatsapp

# Jalur balasan cadangan. Bila kuota Twilio trial habis, balasan AI dikirim
# melalui perangkat Fonnte yang sudah terhubung. Kosongkan untuk memakai Twilio.
FONNTE_TOKEN=
