# Normalisasi akhir baris agar tidak ada perubahan palsu antar sistem operasi.
* text=auto eol=lf

# Skrip shell wajib LF.
*.sh text eol=lf

# Skrip Windows wajib CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Berkas biner, jangan diubah.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary

# Berkas lock dibiarkan apa adanya, jangan digabung otomatis.
package-lock.json -diff merge=binary
pnpm-lock.yaml -diff merge=binary
